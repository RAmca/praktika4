#include <stdio.h>
#include <locale.h>

int main() {
    setlocale(LC_ALL, "Russian");

    int n;
    printf("Введите трёхзначное число: ");
    scanf("%d", &n);

    int last   = n % 10;
    int first  = n / 100;
    int middle = (n / 10) % 10;
    int sum    = first + middle + last;
    int rev    = last * 100 + middle * 10 + first;

    printf("Последняя цифра %d, первая - %d, сумма цифр %d, наоборот - %d\n",
           last, first, sum, rev);

    return 0;
}
