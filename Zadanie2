#include <stdio.h>
#include <locale.h>

int main() {
    setlocale(LC_ALL, "Russian");

    int a = 11;
    int b = 3;

    int    x;
    float  y;
    double z;

    x = a / b;
    y = a / b;
    z = a / b;

    printf("--- Шаг 3: x = a/b, y = a/b, z = a/b ---\n");
    printf("x (int)    = %d\n",  x);
    printf("y (float)  = %f\n",  y);
    printf("z (double) = %lf\n", z);

    printf("\n--- Шаг 6: явное преобразование ---\n");
    printf("(float)a / b  = %f\n",  (float)a / b);
    printf("(double)a / b = %lf\n", (double)a / b);

    printf("\n--- Эксперимент со скобками ---\n");
    printf("(float)(a / b)  = %f\n",  (float)(a / b));

    printf("(float)a / b    = %f\n",  (float)a / b);

    return 0;
}
