#include <stdio.h>
#include <locale.h>

int main() {
    setlocale(LC_ALL, "Russian");

    double x;
    printf("Введите вещественное число: ");
    scanf("%lf", &x);

    int  whole = (int)x;
    double frac = x - whole;

    printf("Целая часть:    %d\n",  whole);
    printf("Дробная часть:  %lf\n", frac);

    return 0;
}
